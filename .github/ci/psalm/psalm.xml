<?xml version="1.0"?>
<psalm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="https://getpsalm.org/schema/config"
       xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
       errorBaseline="psalm-baseline.xml"
       errorLevel="1"
       findUnusedBaselineEntry="true"
       findUnusedCode="false"
       totallyTyped="true"
       autoloader="./autoload.php"
>
    <projectFiles>
        <directory name="../../../src" />
        <directory name="../../../tests" />

        <ignoreFiles>
            <directory name="../../../vendor" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="stubs/frankenphp.php" />
    </stubs>

    <issueHandlers>
        <PropertyNotSetInConstructor errorLevel="suppress" />

        <!-- TODO: Remove this after we fully deprecate the Env class -->
        <DeprecatedClass errorLevel="suppress" />

        <!-- Classes aren't extended because they could potentially be since this is a framework -->
        <ClassMustBeFinal errorLevel="suppress" />

        <!-- Property hooks are a real feature, kthx -->
        <NoInterfaceProperties errorLevel="suppress" />

        <!-- A bunch of false-positives with ??= -->
        <RedundantPropertyInitializationCheck errorLevel="suppress" />

        <!-- Up to the developers to ensure params for child classes match, not us -->
        <UnsafeInstantiation errorLevel="suppress" />

        <!--
            Middleware handler constructors resolve their template to the first option
            in the union rather than the one the subclass declares via @extends. That
            upstream bug is already noted in Cli\Middleware\Handler\Abstract\Handler
            (https://psalm.dev/r/e76d278bf9). PHPStan checks these same call sites and
            reports nothing, so the constructors are correct.
        -->
        <InvalidArgument>
            <errorLevel type="suppress">
                <directory name="../../../tests/Tests/Unit/Cli/Middleware/Handler" />
                <directory name="../../../tests/Tests/Unit/Http/Middleware/Handler" />
            </errorLevel>
        </InvalidArgument>
    </issueHandlers>
</psalm>
