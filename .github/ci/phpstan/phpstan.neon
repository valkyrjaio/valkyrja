includes:
    - phpstan-baseline.neon
parameters:
    level: 9
    bootstrapFiles:
        - ./autoload.php
    paths:
        - ../../../src
        - ../../../tests
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#^Unsafe usage of new static\(\).$#'
        -
            identifier: missingType.generics
        -
            identifier: trait.unused
        # PHPUnit marks its assertions @no-named-arguments, but the suite calls them as
        # assertSame(expected: ..., actual: ...) so the argument order is unambiguous at
        # every call site. Readability wins here; revisit if PHPUnit ever renames a
        # parameter, since nothing would catch it.
        -
            identifier: argument.named
            path: ../../../tests
