includes:
    - phpstan-baseline.neon
parameters:
    level: 9
    bootstrapFiles:
        - ./autoload.php
    paths:
        - ../../../src
        - ../../../tests
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#^Unsafe usage of new static\(\).$#'
        -
            identifier: missingType.generics
        # PHPUnit marks each assertion @no-named-arguments. The suite names each
        # argument, so the order is unambiguous at each call site.
        -
            identifier: argument.named
            path: ../../../tests
