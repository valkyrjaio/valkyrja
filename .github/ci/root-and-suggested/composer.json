{
  "require"           : {
    "php"                     : ">=8.4",
    "psr/container"           : "^2.0.2",
    "psr/event-dispatcher"    : "^1.0.0",
    "psr/http-message"        : "^2.0",
    "psr/http-server-handler" : "^1.0.2",
    "psr/log"                 : "^3.0.2"
  },
  "require-dev"       : {
    "async-aws/sqs"              : "^2.9.0",
    "filp/whoops"                : "^2.18.4",
    "firebase/php-jwt"           : "^7.1.0",
    "guzzlehttp/guzzle"          : "^7.15.3",
    "league/flysystem"           : "^3.35.2",
    "league/flysystem-aws-s3-v3" : "^3.35.2",
    "mailgun/mailgun-php"        : "^4.5.1",
    "monolog/monolog"            : "^3.10.0",
    "openswoole/core"            : "^26.2.1",
    "pda/pheanstalk"             : "^8.0.2",
    "php-amqplib/php-amqplib"    : "^3.7.4",
    "phpmailer/phpmailer"        : "^7.1.1",
    "predis/predis"              : "^3.5.1",
    "pusher/pusher-php-server"   : "^7.2.8",
    "spiral/roadrunner-http"     : "^4.1.0",
    "twig/twig"                  : "^3.28.0",
    "vonage/client-core"         : "^4.14.0"
  },
  "minimum-stability" : "dev",
  "prefer-stable"     : true,
  "config"            : {
    "allow-plugins" : {
      "php-http/discovery" : true
    },
    "platform"      : {
      "ext-openswoole" : "26.2.0"
    }
  }
}
